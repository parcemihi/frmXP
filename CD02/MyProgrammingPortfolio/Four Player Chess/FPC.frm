Attribute VB_Name = "Form1"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Dim P2M As Integer

Dim playlist(4999, 143) As Integer

Private Sub Form_Load()
Dim i As Integer
For i = pieces.LBound To pieces.UBound
    pieces(i).DragMode = 0
Next i
End Sub

Private Sub pieces_MouseDown(Index As Integer, Button As Integer, Shift As Integer, X As Single, Y As Single)
Dim i As Integer
P2M = Index
For i = pieces.LBound To pieces.UBound
    If Not i = Index Then
        pieces(i).Enabled = False
    End If
Next i
pieces(Index).Drag 1
End Sub

Private Sub Form_DragDrop(Source As Control, X As Single, Y As Single)
Dim w As Integer, h As Integer, i As Integer
w = 120
h = 120
Do Until w > X
    w = w + 720
Loop
Do Until h > Y
    h = h + 720
Loop
w = w - 720
h = h - 720

'Insert function for move legality

Call Source.Move(w, h)

For i = pieces.LBound To pieces.UBound
    pieces(i).Enabled = True
    If pieces(i).Top = pieces(P2M).Top And pieces(i).Left = pieces(P2M).Left Then
        If Not P2M = i Then
            pieces(i).Visible = False
            pieces(i).Enabled = False
        End If
    End If
Next i






End Sub
