Attribute VB_Name = "Form1"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Dim i As Integer, j As Integer, k As Integer
Dim MyAry(0 To 99)
Dim x As Integer

Private Sub Form_Load()
Randomize
Form1.Width = 6000
Form1.Height = 6000

j = 500
    For i = 0 To 99
        






x = 0
Do
k = 100 * Rnd
For x = 0 To 99
    If MyAry(x) = k Then
    Exit For
    End If
Next x
Loop Until x = 100

MyAry(i) = k
    
    
    
    
    
    
    
    lbl(i).Width = j
    lbl(i).Height = j
    
    Select Case i
    Case 0 To 9
        lbl(i).Left = i * j + j
        lbl(i).Top = j
        lbl(i).Caption = k
    Case 10 To 19
        lbl(i).Left = (i - 10) * j + j
        lbl(i).Top = j * 2
        lbl(i).Caption = k
    Case 20 To 29
        lbl(i).Left = (i - 20) * j + j
        lbl(i).Top = j * 3
        lbl(i).Caption = k
    Case 30 To 39
        lbl(i).Left = (i - 30) * j + j
        lbl(i).Top = j * 4
        lbl(i).Caption = k
    Case 40 To 49
        lbl(i).Left = (i - 40) * j + j
        lbl(i).Top = j * 5
        lbl(i).Caption = k
    Case 50 To 59
        lbl(i).Left = (i - 50) * j + j
        lbl(i).Top = j * 6
        lbl(i).Caption = k
    Case 60 To 69
        lbl(i).Left = (i - 60) * j + j
        lbl(i).Top = j * 7
        lbl(i).Caption = k
    Case 70 To 79
        lbl(i).Left = (i - 70) * j + j
        lbl(i).Top = j * 8
        lbl(i).Caption = k
    Case 80 To 89
        lbl(i).Left = (i - 80) * j + j
        lbl(i).Top = j * 9
        lbl(i).Caption = k
    Case 90 To 99
        lbl(i).Left = (i - 90) * j + j
        lbl(i).Top = j * 10
        lbl(i).Caption = k
    End Select
    Next i


x = 0
For i = 0 To 99
x = MyAry(i) + x
Form1.Caption = x
Next i


End Sub
