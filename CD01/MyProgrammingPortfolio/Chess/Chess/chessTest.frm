Private Sub Command1_Click(Index As Integer)
Select Case Index
    Case 0 To 7
    ChessRow(0) = "h": ChessCol(0) = Index - 0
    Case 8 To 15
    ChessRow(1) = "g": ChessCol(1) = Index - 8
    Case 16 To 23
    ChessRow(2) = "f": ChessCol(2) = Index - 16
    Case 24 To 31
    ChessRow(3) = "e": ChessCol(3) = Index - 24
    Case 32 To 39
    ChessRow(4) = "d": ChessCol(4) = Index - 32
    Case 40 To 47
    ChessRow(5) = "c": ChessCol(5) = Index - 40
    Case 48 To 55
    ChessRow(6) = "b": ChessCol(6) = Index - 48
    Case 56 To 63
    ChessRow(7) = "a": ChessCol(7) = Index - 56
End Select
End Sub

Private Sub ROW_1_Click(Index As Integer)
ChessRow(0) = Index


End Sub

Private Sub COL_1_Click(Index As Integer)
ChessCol(0) = Index

End Sub

