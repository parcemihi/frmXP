Private Sub Form_Load()
   frmOthello.Caption = "Blacks Move"
   BlacksMove = True
   WhitesMove = False
    
   For load = 0 To 99
   Board(load).Picture = imgBlank.Picture
   Next load

   Board(44).Picture = imgWhite.Picture
   Board(45).Picture = imgBlack.Picture
   Board(54).Picture = imgBlack.Picture
   Board(55).Picture = imgWhite.Picture

End Sub

Private Sub turn()
If BlacksMove = True Then
    frmOthello.Caption = "Whites Move"
    WhitesMove = True
    BlacksMove = False
Else:
    frmOthello.Caption = "Blacks Move"
    BlacksMove = True
    WhitesMove = False
End If
End Sub

