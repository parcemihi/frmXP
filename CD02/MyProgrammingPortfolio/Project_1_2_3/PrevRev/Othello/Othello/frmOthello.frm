Public Function Stats()
Wstat = 0
Bstat = 0
    
    For load = 0 To 100
        If load = 100 Then
        frmWinnerOthello.Show
        frmOthello.Hide
        Exit For
        End If
    If Board(load).Picture = imgBlank.Picture Then
    Exit For
    Else
        If Board(load).Picture = imgWhite Then
        Wstat = Wstat + 1
        End If
        If Board(load).Picture = imgBlack Then
        Bstat = Bstat + 1
        End If
    End If
    Next load
End Function
